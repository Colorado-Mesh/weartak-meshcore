<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    The plugin service below is protected by com.weartak.plugin.permission.BIND_PLUGIN. WearTAK
    defines that permission (signature level) and holds it, so only WearTAK can bind. The plugin
    must not define it: Android refuses to install WearTAK while another app owns it
    (INSTALL_FAILED_DUPLICATE_PERMISSION).
    -->

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- The radio link. Scanning is never used to find the watch's location. No foreground
         service: the link is kept only while WearTAK, which is bound to the plugin, runs it. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <queries>
        <!-- WearTAK release and dev builds, to check who is calling. -->
        <package android:name="com.aitech.weartak_civ" />
        <package android:name="com.aitech.weartak_civ.dev" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- The radio screen. WearTAK opens a plugin's launcher activity when its row in the
             Plugins menu is tapped, so this is how the radio is chosen. -->
        <activity
            android:name=".RadioActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The radio link's retry alarm (RadioLink). -->
        <receiver
            android:name=".RadioLink$RetryReceiver"
            android:exported="false" />

        <service
            android:name=".MeshCorePluginService"
            android:exported="true"
            android:permission="com.weartak.plugin.permission.BIND_PLUGIN">
            <!--
            WearTAK finds plugins with PackageManager.MATCH_DEFAULT_ONLY (on API 33+), which only
            matches intent filters that also carry the DEFAULT category.
            -->
            <intent-filter>
                <action android:name="com.weartak.plugin.action.PLUGIN_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- The line WearTAK shows under the plugin's name in its Plugins menu. -->
            <meta-data
                android:name="com.weartak.plugin.MENU_SUBTITLE"
                android:value="@string/menu_subtitle" />
        </service>
    </application>
</manifest>
